<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/LeKwarta.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculator" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Run the numbers on savings and loans"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSimple"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_type"
                android:gravity="center"
                android:text="Simple"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabCompound"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_type"
                android:gravity="center"
                android:text="Compound"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tabLoan"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_type"
                android:gravity="center"
                android:text="Loan"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCalcHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            style="@style/LeKwarta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Principal (₱)" />

        <EditText
            android:id="@+id/etPrincipal"
            style="@style/LeKwarta.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:hint="10,000"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            style="@style/LeKwarta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Annual rate (%)" />

        <EditText
            android:id="@+id/etRate"
            style="@style/LeKwarta.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:hint="5"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <LinearLayout
            android:id="@+id/layoutTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/LeKwarta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Time (years)" />

        <EditText
            android:id="@+id/etTime"
            style="@style/LeKwarta.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:hint="2"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:id="@+id/tvExtraLabel"
            style="@style/LeKwarta.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Months" />

        <EditText
            android:id="@+id/etExtra"
            style="@style/LeKwarta.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:hint="12"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculate"
            style="@style/LeKwarta.GoldButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Calculate" />

        <!-- Result scoreboard -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_court">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvResultLabel"
                    style="@style/LeKwarta.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/card_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Total interest"
                    android:textColor="@color/gold" />

                <TextView
                    android:id="@+id/tvResult"
                    style="@style/LeKwarta.Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/card_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="₱0.00"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/tvResultSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@color/card_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
